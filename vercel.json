{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/sigari-bio/index.html"
    },
    {
      "source": "/esplora",
      "destination": "/sigari-bio/explore.html"
    },
    {
      "source": "/:handle(@[a-zA-Z0-9_]{1,20})",
      "destination": "/api/profile?h=:handle"
    },
    {
      "source": "/:handle([a-zA-Z0-9_]{1,20})",
      "destination": "/api/profile?h=:handle"
    },
    {
      "source": "/:path((?!sigari-bio/|api/).*)",
      "destination": "/sigari-bio/:path"
    }
  ],
  "functions": {
    "api/profile.js": {
      "includeFiles": "sigari-bio/profile.html"
    },
    "api/discord-setup.js": {
      "includeFiles": "sigari-bio/firestore.rules"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/(dashboard|login)(.html)?",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|jpg|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
